# Compatibility example for environment-variable overrides.
# Prefer copying pano3dgs.example.toml to pano3dgs.toml for normal project configuration.
# Keep this example file portable. Put machine-specific absolute paths in .env or pano3dgs.toml.

PANO3DGS_COLMAP=colmap
PANO3DGS_RUNS_DIR=runs

# Source video defaults
PANO3DGS_RATE_HZ=2.0
PANO3DGS_EQUIRECT_WIDTH=7680
PANO3DGS_EQUIRECT_HEIGHT=3840
PANO3DGS_SCALE_WIDTH=1920
PANO3DGS_FRAME_JPG_QUALITY=98
PANO3DGS_FALLBACK_FPS=30
PANO3DGS_PROGRESS=300

# GPU / COLMAP defaults
PANO3DGS_GPU_INDEX=0
PANO3DGS_THREADS=8
PANO3DGS_CLEAN_COLMAP=false
PANO3DGS_MAX_FEATURES=12000
PANO3DGS_OVERLAP=25

# SAM3 defaults
# Set these in .env if you want `pano-3dgs run` to generate dynamic masks with SAM3.
# Use PANO3DGS_SKIP_SAM3=true or --skip-sam3 to skip SAM3 intentionally.
PANO3DGS_SAM3_MODEL=
PANO3DGS_SAM3_REPO=third_party/sam3
PANO3DGS_DEVICE=cuda:0
PANO3DGS_DTYPE=bfloat16
PANO3DGS_SAM3_PROMPTS=sky,person,people,camera,tripod,selfie stick,phone
PANO3DGS_SKIP_SAM3=false
PANO3DGS_SAM3_SCORE=0.35
PANO3DGS_SAM3_MIN_AREA=0.00005
PANO3DGS_SAM3_MAX_AREA=0.80
PANO3DGS_DILATE=7

# Mask defaults
# Set this to reuse existing SAM3 masks instead of running SAM3 in `pano-3dgs run`.
# PANO3DGS_DYNAMIC_MASK_DIR=/path/to/dynamic_masks
PANO3DGS_MASK_HEURISTICS=auto
PANO3DGS_MASK_PROGRESS=50
PANO3DGS_SKY_MASK=true
PANO3DGS_ZENITH_MASK=0.04
PANO3DGS_NADIR_MASK=0.04

# Cubemap defaults
PANO3DGS_FACE_SIZE=2048
PANO3DGS_FACES=all
PANO3DGS_FOV=90
PANO3DGS_IMAGE_EXT=jpg
PANO3DGS_CUBEMAP_JPG_QUALITY=95
PANO3DGS_CUBEMAP_WORKERS=0
PANO3DGS_MASK_NAME_MODE=colmap

# Official COLMAP panorama SfM workflow defaults
# Use CUDA-enabled PyCOLMAP, preferably from pycolmap-cuda12 or a local CUDA COLMAP source build.
# PANO3DGS_PYCOLMAP_PATH=/path/to/custom/pycolmap/package_parent
PANO3DGS_REQUIRE_PYCOLMAP_CUDA=true
PANO3DGS_PANO_RENDER_TYPE=perspective_overlapping
PANO3DGS_PANORAMA_VIRTUAL_CAMERA_MODEL=pinhole
PANO3DGS_PANORAMA_MATCHER=sequential
PANO3DGS_PANORAMA_MAPPER=incremental
PANO3DGS_PANORAMA_BA_BACKEND=ceres
PANO3DGS_PANORAMA_LOOP_DETECTION=false
# PANO3DGS_PANORAMA_VOCAB_TREE_PATH=/path/to/vocab_tree_faiss_flickr100K_words256K.bin
PANO3DGS_PANORAMA_WORKERS=0
PANO3DGS_PANORAMA_USE_INPUT_MASKS=true
PANO3DGS_RERENDER_PERSPECTIVE=false
PANO3DGS_RERUN_PANORAMA_FEATURES=false
PANO3DGS_RERUN_PANORAMA_MATCHING=false
PANO3DGS_CLEAN_PANORAMA_SFM=false
